# LLM Provider Configuration: 'gemini' or 'claude'
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=mock_synthetic_gemini_key_1234567890abcdef

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=mock_synthetic_anthropic_key_1234567890abcdef

# Tavily Search API Key (Optional, for autonomous agent web research)
TAVILY_API_KEY=tvly-mock_synthetic_tavily_key_1234567890abcdef

# SerpApi Key for Google Scholar & Real-time Web Search (Optional)
SERPAPI_API_KEY=mock_synthetic_serpapi_key_1234567890abcdef

# Financial Modeling Prep (FMP) Key for Real-time Company Metrics (Optional)
FMP_API_KEY=mock_synthetic_fmp_key_1234567890abcdef

# Semantic Scholar API Key (Optional, free tier works without key)
SEMANTIC_SCHOLAR_API_KEY=mock_synthetic_semanticscholar_key_1234567890abcdef

# Hosting & Access Control (Passcode Gate)
DEMO_ACCESS_TOKEN=mock_synthetic_demo_passcode_9876543210fedcba

# Rate Limiting & Concurrency
RATE_LIMIT_PER_HOUR=10
MAX_CONCURRENT_RUNS=2
PIPELINE_TIMEOUT_SECONDS=120
